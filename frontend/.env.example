# Choose exactly one data source: "live" or "fixture".
VITE_DATA_SOURCE=live

# Required when VITE_DATA_SOURCE=live.
VITE_API_BASE_URL=http://localhost:8000

# Optional. Keep false for normal paper demos.
VITE_ENABLE_DEBUG=false

# Optional development-only bearer token for a protected local API.
# Vite embeds VITE_* values in the browser bundle; never use a valuable secret here.
# VITE_API_BEARER_TOKEN=
