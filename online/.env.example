# Reproducible, network-free demonstration mode.
BCA_ONLINE_MODE=fixture
BCA_ASSET_PATH=online/fixtures/demo.json
BCA_ALLOWED_MODELS=fixture-reviewer
BCA_DEFAULT_MODEL=fixture-reviewer
BCA_CORS_ORIGINS=http://localhost:5173

# Optional API protection. Use a random value with at least 16 characters.
# BCA_AUTH_TOKEN=replace-with-a-long-random-token

# Live mode requires both values below and an HTTPS endpoint. Never commit keys.
# BCA_LLM_BASE_URL=https://your-provider.example/v1
# BCA_LLM_API_KEY=replace-at-runtime

BCA_REQUEST_TIMEOUT_SECONDS=300
BCA_RETRIEVE_K=10
BCA_RERANK_N=10
BCA_TOP_SELECT=5
